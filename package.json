{
  "name": "xrncal",
  "version": "0.1.0",
  "description": "Desktop Calendar for Windows and Linux with modern UX and multi-provider sync",
  "private": true,
  "license": "MIT",
  "author": "Xernnn",
  "homepage": "https://github.com/Xernnn/xrncal-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xernnn/xrncal-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/Xernnn/xrncal-desktop/issues"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=23.4"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "clean": "rm -rf out dist *.tsbuildinfo",
    "postinstall": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "pack:win": "npm run build && electron-builder --win --x64",
    "pack:linux": "npm run build && electron-builder --linux AppImage --x64",
    "app:install": "bash scripts/install-linux-app.sh",
    "app:update": "bash scripts/install-linux-app.sh"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.7",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.16.0",
    "luxon": "^3.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.19",
    "rrule": "^2.8.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/luxon": "^3.7.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
