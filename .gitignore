# Dependencies
node_modules/

# Build outputs
out/
dist/
*.tsbuildinfo

# Test coverage and tool caches
coverage/
.cache/
.eslintcache
.vite/

# Logs and temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp

# Environment and credentials. .env.example is the template and stays tracked;
# xrncal.env is the file the app itself reads OAuth client credentials from
# (see src/main/load-credentials.ts) - a copy next to the project must never
# be committed.
.env
.env.*
!.env.example
xrncal.env

# Local databases (the app keeps its own in the user profile, not here)
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
Thumbs.db
